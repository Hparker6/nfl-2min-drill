{
  // Cloudflare serves the Vite build output from dist/; the Worker handles /v1/* (the leaderboard API) and draws the
  // /leaderboard/ and /stats/ pages from the live scores.
  "name": "nfl-2min-drill",
  "main": "server/site/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/v1/*", "/leaderboard", "/leaderboard/", "/stats", "/stats/", "/how-to-play", "/index.html"]
  },
  // leaderboard storage: created by the migration on the next deploy, nothing to set up by hand
  "durable_objects": {
    "bindings": [
      { "name": "DAY_BOARD", "class_name": "DayBoard" },
      { "name": "ALL_DAYS", "class_name": "AllDays" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DayBoard", "AllDays"] }
  ],
  // Accounts and purchases are OFF at the top level (production): no database binding, so /v1/auth, /v1/me, /v1/checkout
  // and /v1/stripe answer 404. The dev environment below turns them on, on this machine only:
  //   npm run build && npx wrangler d1 migrations apply DB --local --env dev && npx wrangler dev --env dev
  //   then, in another terminal: DEV_API=http://localhost:8787 npm run dev, and open http://localhost:5173/?edition=account
  // with secrets in .dev.vars (see .dev.vars.example). The staging environment is further down; production gets the same
  // only after review. Setup for both: server/accounts/SETUP.md.
  "env": {
    "dev": {
      "durable_objects": {
        "bindings": [
          { "name": "DAY_BOARD", "class_name": "DayBoard" },
          { "name": "ALL_DAYS", "class_name": "AllDays" }
        ]
      },
      // local only: wrangler dev simulates this database on disk (.wrangler/), nothing is created in Cloudflare
      "d1_databases": [
        { "binding": "DB", "database_name": "the4thcall-dev", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "server/db/migrations" }
      ],
      "vars": {
        "ACCOUNTS": "on",
        // the Vite dev server, which proxies /v1 here (DEV_API=http://localhost:8787 npm run dev)
        "SITE_ORIGIN": "http://localhost:5173",
        "DEV_ORIGINS": "http://localhost:8787,http://127.0.0.1:8787",
        "MAIL_MODE": "console",
        // test-mode Stripe only (live keys are refused in code); set to on with test secrets in .dev.vars to try checkout
        "PAYMENTS": "off"
      }
    },
    // STAGING: a separate Worker (nfl-2min-drill-staging, on workers.dev) with a real D1 database (the-fourth-call-database,
    // staging only). Accounts on, payments off (Stripe test mode only when turned on; live keys are refused in code).
    // Secrets: wrangler secret put AUTH_PEPPER|RESEND_API_KEY|STRIPE_SECRET_KEY|STRIPE_WEBHOOK_SECRET|STRIPE_PRICE_ID --env staging
    // Order: npx wrangler d1 migrations apply DB --env staging --remote, THEN npm run build && npx wrangler deploy --env staging
    // (tables first, so the Worker never runs against an empty database). Full steps: server/accounts/SETUP.md.
    "staging": {
      "durable_objects": {
        "bindings": [
          { "name": "DAY_BOARD", "class_name": "DayBoard" },
          { "name": "ALL_DAYS", "class_name": "AllDays" }
        ]
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "the-fourth-call-database", "database_id": "42a1a193-5c81-495a-bf0b-730eae04098f", "migrations_dir": "server/db/migrations" }
      ],
      "vars": {
        "ACCOUNTS": "on",
        // EMPTY ON PURPOSE, so accounts stay off until it is right. It must be the staging Worker's exact address, which
        // includes your account's workers.dev subdomain: https://nfl-2min-drill-staging.<your-subdomain>.workers.dev
        // (the first deploy prints it). Sign-in links are built from it: a wrong host would send them somewhere else.
        "SITE_ORIGIN": "https://nfl-2min-drill-staging.houston-parker.workers.dev",
        // sign-in emails through Resend: the key is a secret (wrangler secret put RESEND_API_KEY --env staging); the
        // sender must be an address on a domain verified in Resend
        "MAIL_MODE": "resend",
        "MAIL_FROM": "The 4th Call <signin@nfl-2min-drill.com>",
        "PAYMENTS": "on"
      }
    }
  }
}
