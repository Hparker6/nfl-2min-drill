# Copy to .env.production (or set these in your host's build settings).

# Your public address, no trailing slash. Used for absolute social-preview and canonical URLs.
VITE_SITE_URL=https://example.com

# Google Analytics 4: the site tag is built in. Set another measurement ID here, or "off" for no analytics.
VITE_GA_ID=

# Daily leaderboard: served by this site's Worker at /v1/ (server/site/worker.js). Leave empty for that, set another
# address to use a different server, or "off" to show only the simulated percentile.
VITE_LEADERBOARD_URL=

# Footer links (optional; a link with no address is not shown). https:// or mailto: only.
VITE_FEEDBACK_URL=
VITE_SUPPORT_URL=

# Cloudflare Turnstile site key: shows the bot check on the sign-in and support forms. The Worker needs the matching
# TURNSTILE_SECRET (a Worker secret) or the token is ignored. Cloudflare's test site key 1x00000000000000000000AA passes everything.
VITE_TURNSTILE_SITE_KEY=

# Display ads (optional, off by default). Ads show only when all three are set, the site is approved in AdSense,
# and the Content-Security-Policy allows Google's ad domains. See MONETIZATION.md before turning these on.
VITE_ADS=
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
