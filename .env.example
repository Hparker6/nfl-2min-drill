# Copy to .env.production (or set these in your host's build settings).

# Your public address, no trailing slash. Used for absolute social-preview and canonical URLs.
VITE_SITE_URL=https://example.com

# Optional Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty for no analytics at all.
VITE_GA_ID=

# Optional daily leaderboard (server/leaderboard/). Leave empty to show only the simulated percentile.
VITE_LEADERBOARD_URL=
